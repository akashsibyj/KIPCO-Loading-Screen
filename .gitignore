# ---------------------------------------------------------------
# KIPCO Loading Screen — only the files the project needs are
# committed. Everything else in this folder is ignored by default.
# To add a NEW file to the repo later, add a "!" line for it below.
# ---------------------------------------------------------------

# 1. Ignore everything in the project root...
/*

# 2. ...except these project files
!/.gitignore
!/.gitattributes
!/package.json
!/package-lock.json
!/dev-server.js
!/vercel.json
!/README.md
!/LICENSE-Montserrat.txt

# 3. public/ — the website itself (served by Vercel and by npm start)
!/public/
/public/*
!/public/index.html
!/public/src/
/public/src/*
!/public/src/kipco-loader.js
!/public/src/kipco-loader.css
!/public/assets/
/public/assets/*
!/public/assets/kipco-logo.png

# 4. Safety net: never commit these anywhere, even if un-ignored above
*.mp4
*.mov
*.webm
*.avi
*.mkv
*.bat
*.log
.env
.env.*
.vercel/
node_modules/
Thumbs.db
desktop.ini
.DS_Store
